# External Emerging Collectibles Intelligence Agent — environment variables
# Copy to `.env` and fill values. All keys are OPTIONAL — the system runs
# fully in deterministic, no-LLM, no-paid-API mode without any of them.

# ---------------------------------------------------------------------------
# LLM (optional). Any OpenAI-compatible endpoint works.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Compliant search API providers (optional). Enable in config.yaml too.
# ---------------------------------------------------------------------------
BING_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ---------------------------------------------------------------------------
# News APIs (optional).
# ---------------------------------------------------------------------------
NEWSAPI_KEY=

# ---------------------------------------------------------------------------
# Reddit official Data API (optional; compliant alternative to RSS crawl).
# Create a "script" app at https://www.reddit.com/prefs/apps
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional Cloud Code / Kryo governance adapter (disabled by default).
# See README "Optional Kryo / Cloud Code API adapter". Never hardcode secrets.
# ---------------------------------------------------------------------------
CLOUD_CODE_API_KEY=
CLOUD_CODE_BASE_URL=
KRYO_API_KEY=
